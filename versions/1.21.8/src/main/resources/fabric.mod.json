  "authors": ["qdran"],
  "contact": {
    "homepage": "https://qdran.de"
  },
  "license": "GPL-3.0",
  "icon": "assets/tiersmctagger/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.tiersmctagger.TiersMCTagger"],
    "modmenu": ["dev.tiersmctagger.ModMenuIntegration"]
